# ============================================================
# DT DÉMÉNAGEMENT TUNISIE — Variables d'environnement
# Copier ce fichier en .env.local et remplir toutes les valeurs
# NE JAMAIS COMMITTER .env.local dans le dépôt git
# ============================================================

# BASE DE DONNÉES
DATABASE_URL="postgresql://user:password@host:5432/dt_demenagement"

# PAYLOAD CMS
PAYLOAD_SECRET="min-32-chars-random-string-change-me"
NEXT_PUBLIC_SERVER_URL="https://demenagement.tn"

# NEXTAUTH v5 (Auth.js)
# Générer avec : openssl rand -base64 32
AUTH_SECRET="min-32-chars-random-string-change-me"
# AUTH_URL est auto-détecté en production (Vercel) — optionnel en local
# AUTH_URL="https://demenagement.tn"

# EMAILS — Resend (adaptateur actuel) + fallback SMTP
RESEND_API_KEY="re_..."
RESEND_FROM_ADDRESS="noreply@demenagement.tn"
EMAIL_FROM="DT Déménagement <contact@demenagement.tn>"
EMAIL_DEVIS_TO="contact@demenagement.tn"
# Fallback SMTP (utilisé seulement si RESEND_API_KEY absent)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="contact@demenagement.tn"
SMTP_PASS="votre-mot-de-passe-smtp"

# BOT WHATSAPP — l'app appelle le bot (Railway/VPS) pour envoyer des messages
BOT_SEND_URL="https://bot.demenagement.tn"
BOT_SEND_SECRET="le-meme-secret-que-cote-bot"

# CLOUDINARY — Médias
CLOUDINARY_CLOUD_NAME="votre-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="votre-api-secret"

# TRACKING — GTM / GA4 / Meta Pixel / Clarity
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
NEXT_PUBLIC_GA4_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID="1549116062448283"
NEXT_PUBLIC_CLARITY_ID="votre-clarity-id"

# VERIFICATION — Search Console / Bing / Facebook
NEXT_PUBLIC_GOOGLE_VERIFICATION="ttfGUsdjFBjWApu98FHk6TfriVwQ4JEtIjiB0_IY36Y"
NEXT_PUBLIC_BING_VERIFICATION="46B25AC67993160AC6AA38C2FD7B8E20"
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION="mr2a909oz32tg3cmmybpzsjm0gj8ll"

# GOOGLE PLACES — Avis Google automatiques
GOOGLE_PLACES_API_KEY="AIzaXXXXXXXXXXXXXXXXXXXX"
GOOGLE_PLACE_ID="ChIJ..."

# INSTAGRAM — Feed live
INSTAGRAM_ACCESS_TOKEN="votre-long-lived-token"
INSTAGRAM_USER_ID="votre-user-id"

# BREVO — Newsletter + séquences email
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxx"
BREVO_LIST_ID="1"

# UPSTASH — Anti-spam / Rate limiting
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="votre-token"

# SENTRY — Monitoring erreurs
SENTRY_DSN="https://xxx@sentry.io/xxx"
SENTRY_ORG="dt-demenagement"
SENTRY_PROJECT="website"
SENTRY_AUTH_TOKEN="sntrys_xxx"

# WHATSAPP Business
NEXT_PUBLIC_WHATSAPP_NUMBER="+21652880311"
NEXT_PUBLIC_WHATSAPP_MESSAGE="Bonjour, je souhaite un devis pour mon déménagement."

# CRON — Protection route sync-reviews
CRON_SECRET="random-string-protection-cron-min-20-chars"

# BUNDLE ANALYZER — Mettre à true pour analyser le bundle
ANALYZE="false"
